# Node / Nuxt — стадия web собирает всё из frontend/ заново внутри образа
frontend/node_modules
frontend/.nuxt
frontend/.output
frontend/.data

# Python
**/__pycache__
**/*.py[cod]
.venv
# Именно `**/`: без него шаблон совпадает только в корне контекста, и backend/.pytest_cache
# уезжал в образ вместе с кешем прогонов.
**/.pytest_cache

# Состояние локальных запусков: сохранённые варианты конфигурации. В образе это точка
# монтирования тома, а не содержимое — иначе опубликованный образ разносил бы чужие данные.
backend/data

# Тесты гоняются из исходников (CI и README), в рантайм-слое им делать нечего.
backend/tests

# Git и служебные каталоги агента
.git
.claude

# Офлайн-документация Nuxt UI (2,2 МБ) — нужна только при разработке, не для сборки
nuxt-ui

# graphify: граф — материал для документации, не для образа
graphify-out

# Условия задачи (три PDF в корне) — в образ не нужны
*.pdf

# Прочее
.DS_Store
*.log
